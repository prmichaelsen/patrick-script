# PatrickScript — shell wrapper for the reference interpreter
# Usage: patrickscript [--disassemble] <program.ps>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTERP="$SCRIPT_DIR/src/patrickscript/ps.py"

if ! command -v python3 &>/dev/null; then
    echo "error: python3 is required to run PatrickScript" >&2
    exit 2
fi

exec python3 "$INTERP" "$@"

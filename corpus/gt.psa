; gt: greater-than comparison
; 5 > 3 → 1, 3 > 5 → 0
; Demonstrates: GT (arity 4, gap 2)

PUSH 5         ; 0
PUSH 3         ; 1
GT             ; 2: 5 > 3 → 1
OUTNUM         ; 3: print 1

PUSH 3         ; 4
PUSH 5         ; 5
GT             ; 6: 3 > 5 → 0
OUTNUM         ; 7: print 0

HALT           ; 8

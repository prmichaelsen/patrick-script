; countdown: loop using JUMPNZ, counts 3 → 2 → 1
; Expected output: 3\n2\n1

PUSH 3         ; 0: counter
loop:
DUP            ; 1: copy for OUTNUM
OUTNUM         ; 2: print
PUSH 1         ; 3: decrement
SUB            ; 4: counter - 1
DUP            ; 5: copy for JUMPNZ check
JUMPNZ loop    ; 6: loop while counter != 0
POP            ; 7: drop trailing 0
HALT           ; 8

# PatrickScript assembler — shell wrapper for psa.py
# Usage: psa <program.psa>         # emit .ps to stdout
#        psa --help                # show usage
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ASM="$SCRIPT_DIR/src/patrickscript/psa.py"

if ! command -v python3 &>/dev/null; then
    echo "error: python3 is required to run the PatrickScript assembler" >&2
    exit 2
fi

exec python3 "$ASM" "$@"

<!-- Compiled interpreter (IIFE, exposes window.PS). -->
<script>
<!--__PS_INTERPRETER_IIFE__-->
</script>

<!-- Examples table and UI controller. -->
<script>
const EXAMPLES = <!--__PS_EXAMPLES_JSON__-->;
const EXAMPLE_ORDER = <!--__PS_EXAMPLE_ORDER_JSON__-->;

// Speed levels (ms-per-step). Index 0 = slowest, last = "instant".
const SPEED_LEVELS_MS = [500, 250, 120, 60, 30, 12, 0];
const SPEED_LABELS    = ['1×',  '2×',  '4×',  '8×','16×','32×','∞'];

const $ = (id) => document.getElementById(id);

let interp = null;
let runHandle = null;       // setTimeout / rAF handle when auto-running
let currentSlug = null;
let speedIdx = 3;           // matches initial range value

function init() {
  const sel = $('example-select');
  for (const slug of EXAMPLE_ORDER) {
    const opt = document.createElement('option');
    opt.value = slug;
    opt.textContent = EXAMPLES[slug].label || slug;
    sel.appendChild(opt);
  }
  sel.addEventListener('change', () => {
    loadExample(sel.value, /*pushHash=*/true);
  });

  $('btn-run').addEventListener('click', toggleRun);
  $('btn-step').addEventListener('click', () => { stopAuto(); doStep(); render(); });
  $('btn-reset').addEventListener('click', () => { stopAuto(); doReset(); render(); });
  $('speed').addEventListener('input', (e) => {
    speedIdx = parseInt(e.target.value, 10);
    $('speed-label').textContent = SPEED_LABELS[speedIdx];
    // If auto-running, restart the loop with the new delay
    if (runHandle !== null) {
      stopAuto();
      startAuto();
    }
  });

  window.addEventListener('hashchange', applyHash);

  // Default speed label
  $('speed-label').textContent = SPEED_LABELS[speedIdx];

  applyHash();
}

function applyHash() {
  const slug = (location.hash || '').replace(/^#/, '');
  const target = (slug && EXAMPLES[slug]) ? slug : EXAMPLE_ORDER[0];
  if (target !== currentSlug) {
    $('example-select').value = target;
    loadExample(target, /*pushHash=*/false);
  }
}

function loadExample(slug, pushHash) {
  stopAuto();
  currentSlug = slug;
  if (pushHash) {
    if (location.hash !== '#' + slug) {
      history.replaceState(null, '', '#' + slug);
    }
  }
  const ex = EXAMPLES[slug];
  interp = new PS.Interpreter(ex.source, ex.stdin || '');
  render(/*firstLoad=*/true);
}

function doStep() {
  if (!interp) return;
  const st = interp.state();
  if (st.status !== 'running') return;
  interp.step();
}

function doReset() {
  const ex = EXAMPLES[currentSlug];
  if (!ex) return;
  interp.reset(ex.source, ex.stdin || '');
}

function toggleRun() {
  if (runHandle !== null) {
    stopAuto();
    render();
  } else {
    // If halted/errored, reset first
    const st = interp.state();
    if (st.status !== 'running') {
      doReset();
    }
    startAuto();
  }
}

function startAuto() {
  const delay = SPEED_LEVELS_MS[speedIdx];
  $('btn-run').textContent = '⏸ pause';
  $('btn-run').classList.remove('primary');
  if (delay === 0) {
    // "Instant" mode: run to completion in a tight loop (chunked to keep UI alive).
    runChunk();
  } else {
    runHandle = setInterval(() => {
      const st = interp.state();
      if (st.status !== 'running') { stopAuto(); render(); return; }
      interp.step();
      render();
    }, delay);
  }
}

function runChunk() {
  // Process up to N steps per frame; render once per frame.
  const N = 2000;
  runHandle = -1; // sentinel: we're running in instant mode
  let chunk = 0;
  while (chunk < N) {
    const st = interp.state();
    if (st.status !== 'running') break;
    interp.step();
    chunk += 1;
  }
  render();
  const st = interp.state();
  if (st.status === 'running' && runHandle === -1) {
    requestAnimationFrame(runChunk);
  } else {
    stopAuto();
  }
}

function stopAuto() {
  if (runHandle !== null && runHandle !== -1) {
    clearInterval(runHandle);
  }
  runHandle = null;
  $('btn-run').textContent = '▶ run';
  $('btn-run').classList.add('primary');
}

function render() {
  if (!interp) return;
  const st = interp.state();
  const program = interp.program();

  // --- source listing
  const srcEl = $('source-listing');
  if (srcEl.dataset.slug !== currentSlug) {
    srcEl.innerHTML = '';
    for (let i = 0; i < program.length; i++) {
      const m = PS.mnemonicOf(program[i]);
      const span = document.createElement('span');
      span.className = 'src-line';
      span.dataset.idx = String(i);
      const idxStr = String(i).padStart(4, ' ');
      span.innerHTML =
        '<span class="idx">' + escapeHtml(idxStr) + '</span>' +
        '<span class="mnemonic fam-' + escapeAttr(m.family) + '">' + escapeHtml(m.mnemonic.padEnd(12, ' ')) + '</span>' +
        '<span class="desc">; ' + escapeHtml(m.description) + '</span>' +
        '\n';
      srcEl.appendChild(span);
    }
    srcEl.dataset.slug = currentSlug;
  }
  // Highlight current PC and last-executed
  for (const node of srcEl.querySelectorAll('.src-line')) {
    node.classList.remove('current', 'last');
  }
  if (st.ip < program.length) {
    const curEl = srcEl.querySelector('[data-idx="' + st.ip + '"]');
    if (curEl) {
      curEl.classList.add('current');
      // Scroll to keep PC visible (no animation, just instant)
      const pane = $('source-pane');
      const r = curEl.getBoundingClientRect();
      const p = pane.getBoundingClientRect();
      if (r.top < p.top + 30 || r.bottom > p.bottom - 30) {
        curEl.scrollIntoView({ block: 'center', inline: 'nearest' });
      }
    }
  }
  if (st.lastExecuted) {
    const lastEl = srcEl.querySelector('[data-idx="' + st.lastExecuted.idx + '"]');
    if (lastEl && lastEl !== srcEl.querySelector('.current')) {
      lastEl.classList.add('last');
    }
  }

  // --- stack
  const stackWrap = $('stack-view');
  stackWrap.innerHTML = '';
  if (st.stack.length === 0) {
    const e = document.createElement('div');
    e.className = 'stack-empty';
    e.textContent = '(empty)';
    stackWrap.appendChild(e);
  } else {
    for (let i = 0; i < st.stack.length; i++) {
      const v = st.stack[i];
      const c = document.createElement('div');
      c.className = 'stack-cell' + (i === st.stack.length - 1 ? ' top' : '');
      c.textContent = String(v);
      stackWrap.appendChild(c);
    }
  }

  // --- memory
  const memTbody = $('mem-view').querySelector('tbody');
  memTbody.innerHTML = '';
  const memKeys = Object.keys(st.memory).map(Number).sort((a,b) => a-b);
  if (memKeys.length === 0) {
    memTbody.innerHTML = '<tr><td colspan="3" class="mem-empty">(empty)</td></tr>';
  } else {
    for (const k of memKeys) {
      const v = st.memory[k];
      const tr = document.createElement('tr');
      const asciiCell = (v >= 32 && v <= 126)
        ? "'" + String.fromCharCode(v).replace(/'/g, "\\'") + "'"
        : (v === 10 ? "'\\n'" : '');
      tr.innerHTML =
        '<td class="addr">' + escapeHtml(String(k)) + '</td>' +
        '<td>' + escapeHtml(String(v)) + '</td>' +
        '<td class="ascii">' + escapeHtml(asciiCell) + '</td>';
      memTbody.appendChild(tr);
    }
  }

  // --- IO
  const stdinView = $('stdin-view');
  if (st.stdin.length === 0) {
    stdinView.classList.add('empty');
    stdinView.textContent = '(none)';
  } else {
    stdinView.classList.remove('empty');
    stdinView.textContent = bytesToDisplay(st.stdin);
  }
  const stdoutView = $('stdout-view');
  if (st.stdout.length === 0) {
    stdoutView.classList.add('empty');
    stdoutView.textContent = '(none)';
  } else {
    stdoutView.classList.remove('empty');
    stdoutView.textContent = bytesToDisplay(st.stdout);
  }
  const lastView = $('last-instr-view');
  if (st.lastExecuted) {
    lastView.classList.remove('empty');
    lastView.textContent = '@' + st.lastExecuted.idx + '  ' + st.lastExecuted.mnemonic;
  } else {
    lastView.classList.add('empty');
    lastView.textContent = '(none)';
  }
  const errRow = $('error-row');
  if (st.status === 'error' && st.error) {
    errRow.style.display = '';
    $('error-view').textContent = st.error;
  } else {
    errRow.style.display = 'none';
  }

  // --- pills + button state
  $('pc-pill').textContent = String(st.ip);
  $('steps-pill').textContent = String(st.steps);
  const sp = $('status-pill');
  sp.textContent = st.status;
  sp.classList.remove('running', 'halted', 'error');
  sp.classList.add(st.status);

  const halted = (st.status !== 'running');
  $('btn-step').disabled = halted;
}

function bytesToDisplay(bytes) {
  const dec = new TextDecoder('utf-8', { fatal: false });
  const s = dec.decode(new Uint8Array(bytes));
  return s.replace(/\r/g, '');
}

function escapeHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function escapeAttr(s) {
  return s.replace(/[^A-Za-z0-9_-]/g,'_');
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
</script>

</body>
</html>

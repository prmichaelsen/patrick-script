<style>
  :root {
    --bg: #08090b;
    --fg: #ededeb;
    --dim: #6b6b67;
    --rule: #1c1d21;
    --accent: #ffc857;
    --space: #2a2a30;
    --code-bg: #11131a;
    --code-border: #2e2f36;
    --code-fg: #ffe9a8;
  }
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  /* Overflow-x guard. Last-resort safety net so no element can push the
     viewport horizontally on mobile (e.g. an unbreakable token in
     transcluded spec content, a future addition that forgets to wrap, a
     long URL inline). Combined with max-width: 100% on the document root
     and on heavy children (pre, table, img, code). The actual overflowing
     element should still be fixed where found — the clip here is a guard,
     not a substitute. */
  html, body { overflow-x: hidden; max-width: 100vw; }
  html { background: var(--bg); }
  body {
    background: var(--bg);
    color: var(--fg);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    padding: 6vh 5vw 12vh;
    max-width: 880px;
    margin: 0 auto;
  }
  /* Hard ceiling on intrinsically-wide media. `max-width: 100%` keeps
     these children from busting their container; tables get a
     `display: block` + `overflow-x: auto` treatment lower down so a
     genuinely-wide table scrolls inside its own box rather than the
     page. */
  img, video, iframe, svg { max-width: 100%; height: auto; }
  a { color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; }
  a:hover { border-bottom-color: var(--accent); }
  h1 {
    font-size: 2.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }
  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--dim);
    margin: 3.5rem 0 1rem;
    font-weight: 500;
  }
  p { margin: 0.9rem 0; }
  p.lede {
    font-size: 1.1rem;
    color: var(--fg);
    margin-top: 0.4rem;
    max-width: 64ch;
  }
  .meta {
    color: var(--dim);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 1.4rem;
  }
  /* Constraints block — the two givens that bound the LLM's design space. */
  .constraints {
    border: 1px solid var(--code-border);
    background: var(--code-bg);
    padding: 1.4rem 1.4rem 1.2rem;
    margin: 2rem 0 1rem;
  }
  .constraints h3 {
    color: var(--dim);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
    margin-bottom: 0.9rem;
  }
  .constraints ol {
    list-style: none;
    padding-left: 0;
    counter-reset: ck;
  }
  .constraints ol li {
    counter-increment: ck;
    padding: 0.45rem 0 0.45rem 2.3rem;
    position: relative;
    line-height: 1.55;
  }
  .constraints ol li::before {
    content: counter(ck);
    position: absolute;
    left: 0;
    top: 0.45rem;
    color: var(--accent);
    font-weight: 600;
    width: 1.6rem;
  }
  .constraints .key {
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.74rem;
    display: block;
    margin-bottom: 0.15rem;
  }
  .alphabet {
    display: flex;
    gap: 1.4rem;
    align-items: stretch;
    flex-wrap: wrap;
    margin: 2.4rem 0 0.6rem;
    padding: 1.6rem 1.4rem;
    border: 1px solid var(--code-border);
    background: var(--code-bg);
  }
  /* Each token + label is one inseparable unit. Column-stack the chip and
     its caption so they never reflow apart on a narrow viewport. */
  .alphabet .pair {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  /* Both tokens render as discrete bordered chips so they read as
     "this is one token," not as inline prose. Same chrome on both so
     the SPACE chip has the same visual weight as the WORD chip. */
  .alphabet .tok {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: var(--code-fg);
    background: var(--bg);
    border: 1px solid var(--code-border);
    padding: 0.5rem 0.9rem;
    border-radius: 3px;
    min-height: 2.6rem;
    box-sizing: border-box;
  }
  .alphabet .tok-word { color: var(--accent); }
  /* The SPACE token must have a visible glyph or it reads as blank. Use
     the canonical "space" glyph U+2423 (open box) so a viewer sees a
     concrete mark whose meaning is "space character." */
  .alphabet .tok-space {
    min-width: 2.6rem;
    color: var(--accent);
    letter-spacing: 0;
  }
  .alphabet .label {
    color: var(--dim);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }
  /* Fenced code block — distinct color + visible border so code reads in
     isolation from prose. */
  pre {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    color: var(--code-fg);
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.55;
    white-space: pre;
  }
  pre.raw { color: var(--dim); }
  pre.raw .p { color: var(--accent); }
  /* Wrapped raw .ps block. Raw PatrickScript source is long runs of
     `patrick` and spaces; without wrap it forces horizontal scroll,
     especially on mobile. `pre-wrap` keeps the spaces (which encode
     instruction arguments) intact while allowing line breaks; the
     break-word fallback handles unbroken runs of concatenated
     `patrickpatrickpatrick...` so they wrap mid-run instead of
     blowing past the viewport. */
  pre.ps-wrap {
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    overflow-x: visible;
  }
  /* Per-program subheading inside the Programs section. Smaller than
     the section h2s so the progression reads as items under one
     section, not as a new section per program. */
  h3.prog {
    color: var(--code-fg);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin: 2.2rem 0 0.7rem;
  }
  h3.prog .desc {
    color: var(--dim);
    font-weight: 400;
    letter-spacing: 0;
    margin-left: 0.5rem;
  }
  pre code { font-family: inherit; }
  .comment { color: var(--dim); }
  .kw { color: var(--accent); }
  /* Inline code — distinct color, visible border, padding, and
     `white-space: pre` so a single ` ` is rendered as a visible box
     instead of collapsing into prose-colored whitespace. */
  code {
    color: var(--code-fg);
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    padding: 0.05em 0.4em;
    border-radius: 2px;
    font-size: 0.92em;
    /* `pre-wrap` (not `pre`) so a long inline token like
       `patrickpatrickpatrickpatrick…` or a long URL can wrap on mobile.
       Whitespace is still preserved, so the canonical visible-space case
       (`<code> </code>` demonstrating the SPACE token inline) renders
       identically — a visible padded box. Combined with the two break
       rules below, even unbreakable runs of `patrick` characters fall
       back to mid-token wrapping rather than dragging the body sideways. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
    max-width: 100%;
  }
  /* Don't double-decorate code that lives inside a pre — pre already has
     border, bg, padding, color; the inner <code> should inherit. */
  pre code {
    color: inherit;
    background: transparent;
    border: 0;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
    white-space: inherit;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.86rem;
  }
  th, td {
    text-align: left;
    padding: 0.45rem 0.8rem 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  th { color: var(--dim); font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.72rem; }
  td.arity { color: var(--accent); width: 4rem; }
  td.mn { width: 7rem; }
  /* Inline code inside table cells should keep its boxed treatment but
     stay sized down a touch so the rows don't bloat. */
  td code, th code { font-size: 0.88em; padding: 0.02em 0.32em; }
  hr { border: 0; border-top: 1px solid var(--rule); margin: 4.5rem 0 0; }
  footer {
    color: var(--dim);
    font-size: 0.78rem;
    margin-top: 2rem;
    letter-spacing: 0.04em;
  }
  footer a { color: var(--dim); border-bottom: 1px solid var(--rule); }
  footer a:hover { color: var(--fg); border-bottom-color: var(--fg); }
  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  /* ─── Embedded full spec ──────────────────────────────────────────────
     The Full Specification section is transcluded at build time from
     spec/patrickscript.md and lives inside <section class="spec-embed">.
     The spec's heading levels (h1 → "PatrickScript Language Specification";
     h2 → "1. Overview", "2. Lexical Model", …; h3, h4 → subsections) need
     their own treatment so they don't collide with the page's all-caps
     dim section h2 style. Scoped rules override the global heading styles
     for everything under .spec-embed only.
  */
  .spec-embed {
    margin-top: 1.5rem;
    color: var(--fg);
  }
  .spec-embed > p:first-of-type { margin-top: 0.4rem; }
  .spec-embed h1 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--fg);
    margin: 2rem 0 0.6rem;
  }
  .spec-embed h2 {
    font-size: 1.15rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--fg);
    font-weight: 600;
    margin: 2.6rem 0 0.7rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--rule);
  }
  .spec-embed h3 {
    font-size: 1rem;
    color: var(--code-fg);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    margin: 1.8rem 0 0.5rem;
  }
  .spec-embed h4 {
    font-size: 0.9rem;
    color: var(--dim);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 1.4rem 0 0.4rem;
  }
  .spec-embed hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 2.4rem 0;
  }
  .spec-embed ul, .spec-embed ol {
    margin: 0.6rem 0 0.6rem 1.4rem;
    padding-left: 0.4rem;
  }
  .spec-embed li { margin: 0.25rem 0; }
  .spec-embed li > p { margin: 0.3rem 0; }
  /* Spec code blocks (fenced ``` … ```) and the spec's heavy use of
     `inline code` should match the page's existing pre/code styling
     — they already do, because the global rules apply. Just make sure
     spec <pre> blocks wrap on narrow viewports the same way the rest
     of the page does. */
  .spec-embed pre {
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    overflow-x: visible;
  }
  /* Spec tables (rendered from markdown) can be intrinsically wide
     (the ISA opcode table, the encoding examples). On narrow viewports
     box them into their own scroll container so the page itself stays
     within the viewport — the table scrolls horizontally inside its
     box rather than dragging the body sideways. */
  .spec-embed table {
    margin: 1rem 0 1.6rem;
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .spec-embed th, .spec-embed td {
    padding: 0.4rem 0.9rem 0.4rem 0;
  }
  .spec-embed blockquote {
    border-left: 2px solid var(--code-border);
    padding-left: 1rem;
    color: var(--dim);
    margin: 0.9rem 0;
  }
  /* Affordance for the in-page jump from Read further → Full
     Specification. The target is the section h2 of the embedded spec. */
  .spec-embed:target,
  #full-specification:target {
    scroll-margin-top: 1rem;
  }
  @media (max-width: 640px) {
    body { font-size: 14px; padding: 4vh 5vw 10vh; }
    h1 { font-size: 1.9rem; }
    .grid2 { grid-template-columns: 1fr; }
    .alphabet, .constraints { padding: 1.2rem 1rem; }
    /* Wrap normal code blocks so long URLs (git clone …) don't force
       horizontal scroll on phones. `.raw` keeps `white-space: pre` so the
       patrick…patrick truncation stays visually intact. */
    pre:not(.raw) { white-space: pre-wrap; word-break: break-word; overflow-x: visible; }
    /* The Hello World .raw column has `white-space: pre`; cap it to the
       container so the long truncated patrick…patrick line cannot push
       the column wider than its grid track. The pre's own overflow-x
       auto handles internal scroll. */
    pre.raw { max-width: 100%; overflow-x: auto; }
    /* Larger tap targets on the Read-further list (44pt-ish). */
    ul li a { display: inline-block; padding: 0.55rem 0; }
    /* The page-level ISA / mnemonic table also gets the scroll-in-box
       treatment on mobile (same as .spec-embed table) — otherwise a wide
       row would force the body wider than the viewport. */
    table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
    }
    .spec-embed h1 { font-size: 1.3rem; }
    .spec-embed h2 { font-size: 1.05rem; }
  }
</style>

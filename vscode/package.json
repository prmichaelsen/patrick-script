{
  "name": "patrickscript-vscode",
  "displayName": "PatrickScript",
  "description": "Syntax highlighting, per-arity semantic coloring, inline disassembly (inlay hints), hover, outline, and parse-error diagnostics for PatrickScript (.ps) and PatrickScript Assembly (.psa). Reuses the official TypeScript interpreter for correctness.",
  "version": "0.1.0",
  "publisher": "patrickscript",
  "repository": {
    "type": "git",
    "url": "https://github.com/patrickscript/patrick-script"
  },
  "homepage": "https://patrickscript.com",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "patrickscript",
    "esolang",
    "stack-machine",
    "disassembler",
    "two-token",
    "unary"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:patrickscript",
    "onLanguage:patrickscript-assembly"
  ],
  "contributes": {
    "languages": [
      {
        "id": "patrickscript",
        "aliases": ["PatrickScript", "patrickscript"],
        "extensions": [".ps"],
        "configuration": "./language-configuration.ps.json"
      },
      {
        "id": "patrickscript-assembly",
        "aliases": ["PatrickScript Assembly", "patrickscript-assembly"],
        "extensions": [".psa"],
        "configuration": "./language-configuration.psa.json"
      }
    ],
    "grammars": [
      {
        "language": "patrickscript",
        "scopeName": "source.patrickscript",
        "path": "./syntaxes/patrickscript.tmLanguage.json"
      },
      {
        "language": "patrickscript-assembly",
        "scopeName": "source.patrickscript-assembly",
        "path": "./syntaxes/patrickscript-assembly.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      { "id": "patrickscript.arity1",  "description": "PUSH word (arity 1)" },
      { "id": "patrickscript.arity2",  "description": "Stack op word (arity 2: POP/DUP/SWAP/ROT)" },
      { "id": "patrickscript.arity3",  "description": "Arithmetic word (arity 3: ADD/SUB/MUL/DIV/MOD/NEG)" },
      { "id": "patrickscript.arity4",  "description": "Comparison/bitwise word (arity 4: EQ/LT/GT/AND/OR/XOR/NOT)" },
      { "id": "patrickscript.arity5",  "description": "JUMP word (arity 5)" },
      { "id": "patrickscript.arity6",  "description": "JUMPZ word (arity 6)" },
      { "id": "patrickscript.arity7",  "description": "JUMPNZ word (arity 7)" },
      { "id": "patrickscript.arity8",  "description": "I/O word (arity 8: INCHAR/OUTCHAR/INNUM/OUTNUM)" },
      { "id": "patrickscript.arity9",  "description": "Memory word (arity 9: LOAD/STORE)" },
      { "id": "patrickscript.arity10", "description": "HALT word (arity 10)" },
      { "id": "patrickscript.arity11", "description": "CALL word (arity 11)" },
      { "id": "patrickscript.arity12", "description": "RET word (arity 12)" },
      { "id": "patrickscript.arity13", "description": "PUSHN word (arity 13)" },
      { "id": "patrickscript.arity14", "description": "PICK word (arity 14)" }
    ],
    "semanticTokenScopes": [
      {
        "language": "patrickscript",
        "scopes": {
          "patrickscript.arity1":  ["constant.numeric.ps"],
          "patrickscript.arity2":  ["variable.other.ps"],
          "patrickscript.arity3":  ["keyword.operator.arithmetic.ps"],
          "patrickscript.arity4":  ["keyword.operator.logical.ps"],
          "patrickscript.arity5":  ["keyword.control.flow.ps"],
          "patrickscript.arity6":  ["keyword.control.flow.conditional.ps"],
          "patrickscript.arity7":  ["keyword.control.flow.conditional.ps"],
          "patrickscript.arity8":  ["support.function.io.ps"],
          "patrickscript.arity9":  ["storage.modifier.memory.ps"],
          "patrickscript.arity10": ["keyword.control.halt.ps"],
          "patrickscript.arity11": ["entity.name.function.call.ps"],
          "patrickscript.arity12": ["entity.name.function.return.ps"],
          "patrickscript.arity13": ["constant.numeric.negative.ps"],
          "patrickscript.arity14": ["variable.other.pick.ps"]
        }
      }
    ],
    "configuration": {
      "title": "PatrickScript",
      "properties": {
        "patrickscript.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show decoded-instruction inlay hints inline before each `patrick` word in .ps files."
        },
        "patrickscript.inlayHints.showOperand": {
          "type": "boolean",
          "default": true,
          "description": "Include the operand value (e.g. `PUSH 5`) in inlay hints; when false, show only the family (`PUSH`)."
        },
        "patrickscript.semanticTokens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Colorize each `patrick` word in .ps files by its arity (which is its opcode family)."
        },
        "patrickscript.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Surface PatrickScript parse errors as squigglies."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "build:watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.4.0"
  }
}
